# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Supabase Postgres connection string (Project Settings -> Database ->
# Connection string -> URI). Percent-encode any special characters in the
# password (e.g. "@" -> "%40") since it sits in the URL's userinfo segment.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.your-project-ref.supabase.co:5432/postgres
